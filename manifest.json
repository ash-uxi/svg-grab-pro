{
  "manifest_version": 3,
  "name": "SVG Grab Pro",
  "version": "2.0.0",
  "description": "Grab any SVG on any website. Right-click to copy or download it, or browse every SVG on the page.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "svg-grab-pro@ashuxi",
      "strict_min_version": "140.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "icons": {
    "16": "images/dark/icon16.png",
    "48": "images/dark/icon48.png",
    "128": "images/dark/icon128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "SVG Grab Pro",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/dark/icon16.png",
      "48": "images/dark/icon48.png",
      "128": "images/dark/icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Show every SVG on this page"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  }
}
